---
import { seasonData, currentSeason, type Season } from '@/data/season';

const seasons = Object.keys(seasonData) as Season[];
---

<header>
  <nav>
    <ul
      class="flex flex-wrap justify-center bg-darkblueish rounded-2xl mb-8 px-2"
    >
      {
        seasons.map((season) => (
          <li class="border-r-2 border-grayish last:border-r-0 border-y-2 hover:border-y-reddish transition-all duration-200 text-sm">
            <a
              href={season === currentSeason ? '/' : `/sesong/${season}`}
              class="p-2 block"
            >
              Sesong {Number(season)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
